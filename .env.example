# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Optional: direct (unpooled) connection used only for migrations, if your host gives you one (Neon does)
DATABASE_URL_UNPOOLED=""
# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public URL of the app (used for auth callbacks, emails and the DUPR redirect)
APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"

# ─── DUPR ────────────────────────────────────────────────────────────────────
# none | mock | dupr
#   none – no rating provider: ratings can't be verified (safe production default)
#   mock – development/demo only test provider; refused in production unless DEMO_MODE=true
#   dupr – official DUPR partner API (not implemented yet — see docs/DUPR_INTEGRATION.md)
DUPR_PROVIDER="none"
# Only for a clearly labelled demo deployment that uses the mock provider in production mode
DEMO_MODE="false"
DUPR_API_BASE_URL=""            # e.g. https://uat.mydupr.com/api (UAT) or https://api.dupr.com/api
DUPR_CLIENT_KEY=""
DUPR_CLIENT_SECRET=""
DUPR_WEBHOOK_SECRET=""          # shared secret used to verify rating webhooks

# ─── Background jobs ─────────────────────────────────────────────────────────
# Bearer token for GET/POST /api/cron/tick (call every ~5 minutes)
CRON_SECRET="replace-with-a-random-token"

# ─── Storage & email ─────────────────────────────────────────────────────────
# Profile photos: "db" (stored in PostgreSQL — simplest, works on Vercel), "local" (UPLOAD_DIR on a
# persistent disk) or "s3" (any S3-compatible bucket: Cloudflare R2, AWS S3, Backblaze B2, MinIO…).
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/avatars"
S3_ENDPOINT=""                   # e.g. https://<account-id>.r2.cloudflarestorage.com (empty for AWS S3)
S3_REGION="auto"                 # "auto" for R2, e.g. eu-central-1 for AWS
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Email: either one URL…
SMTP_URL=""                      # e.g. smtps://user:pass@smtp.example.com:465 — without SMTP, emails are only logged
# …or separate fields (easier when the login contains "@", as Brevo's does):
SMTP_HOST=""                     # e.g. smtp-relay.brevo.com
SMTP_PORT=""                     # e.g. 587
SMTP_USER=""                     # e.g. the SMTP login shown by Brevo
SMTP_PASS=""                     # the SMTP key
MAIL_FROM="Pickleball København <noreply@example.com>"
MAIL_REPLY_TO=""                 # where members' replies go, e.g. a mailbox you read

# First admin: this email becomes admin once verified, but only while the club has no admin.
INITIAL_ADMIN_EMAIL=""
